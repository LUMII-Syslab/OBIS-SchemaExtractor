<?xml version="1.0" encoding="UTF-8"?>

<configuration>
    <contextName>obis-schema-extractor</contextName>

    <property name="defaultPattern" value="%d{ISO8601} %5p [%t] [%c{3}] [%X{ipAddress}:%X{user}]: %m%n" />

    <!-- Console appender configuration -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${defaultPattern}</pattern>
        </encoder>
    </appender>

    <!-- File appender configuration -->
    <appender name="LOGFILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <File>logs/schema-extractor.log</File>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <MaxFileSize>10000KB</MaxFileSize>
        </triggeringPolicy>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <maxIndex>21</maxIndex>
            <FileNamePattern>logs/schema-extractor.%i.log</FileNamePattern>
        </rollingPolicy>
        <encoder>
            <pattern>${defaultPattern}</pattern>
        </encoder>
        <!-- Route extraction events to the run-specific file instead of the server log. -->
        <filter class="lv.lumii.obis.schema.services.logging.ExtractionLogFilter">
            <insideExtraction>false</insideExtraction>
        </filter>
    </appender>

    <appender name="EXTRACTION_LOG" class="ch.qos.logback.classic.sift.SiftingAppender">
        <filter class="lv.lumii.obis.schema.services.logging.ExtractionLogFilter">
            <insideExtraction>true</insideExtraction>
        </filter>
        <discriminator>
            <key>extractionLog</key>
            <defaultValue>schema-extraction</defaultValue>
        </discriminator>
        <!-- Normal requests close their file at completion. The timeout covers abandoned runs. -->
        <timeout>24 hours</timeout>
        <sift>
            <appender name="EXTRACTION_LOG-${extractionLog}" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <rollingPolicy class="lv.lumii.obis.schema.services.logging.ExtractionLogRollingPolicy">
                    <fileBaseName>logs/${extractionLog}</fileBaseName>
                </rollingPolicy>
                <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
                    <maxFileSize>10000KB</maxFileSize>
                    <checkIncrement>1 second</checkIncrement>
                </triggeringPolicy>
                <encoder>
                    <pattern>${defaultPattern}</pattern>
                </encoder>
            </appender>
        </sift>
    </appender>

    <logger name="lv.lumii.obis.schema.services.common.SparqlEndpointProcessor" level="INFO" additivity="false">
        <appender-ref ref="LOGFILE"/>
        <appender-ref ref="EXTRACTION_LOG"/>
    </logger>

    <!-- Keep per-entity extraction procedure starts in file logs without changing existing console logging. -->
    <logger name="lv.lumii.obis.schema.services.extractor.v2.SchemaExtractor.detail" level="INFO" additivity="false">
        <appender-ref ref="LOGFILE"/>
        <appender-ref ref="EXTRACTION_LOG"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOGFILE"/>
        <appender-ref ref="EXTRACTION_LOG"/>
    </root>

</configuration>
